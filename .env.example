# Copy to `.env.local` for local development only (`.env.local` is gitignored).
# Packaged release builds ignore these files and use production defaults + Vercel OAuth proxy.
#
# Development server port (default: 5173)
VITE_DEV_PORT=5173

# --- Release-style test (matches DMG behavior; no desktop secret) ---
# QF_CLIENT_ID=0059acb5-8d81-4535-8070-02c072166ff8
# QURAN_REDIRECT_URI=https://ayati-website.vercel.app/oauth/callback
# QURAN_BACKEND_BASE_URL=https://ayati-website.vercel.app
# QURAN_FOUNDATION_ENV=production
#
# QF_CLIENT_SECRET belongs only in the Ayati website Vercel project — never here for release testing.

# --- Personal prelive dev (direct OAuth; your Request Access client) ---
# QF_CLIENT_ID=your-client-id
# QF_CLIENT_SECRET=your-client-secret
# QURAN_REDIRECT_URI=https://ayati-website.vercel.app/oauth/callback
# QURAN_FOUNDATION_ENV=prelive
